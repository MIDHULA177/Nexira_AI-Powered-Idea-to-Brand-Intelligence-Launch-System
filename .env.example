# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=nexira

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Default admin (hardcoded for hackathon judges) ────────────────────────────
# These credentials are used to seed the default admin account on first run.
# Login at /login with these credentials to access the Admin Dashboard.
DEFAULT_ADMIN_EMAIL=admin@nexira.com
DEFAULT_ADMIN_PASSWORD=nexira_admin_2024
DEFAULT_ADMIN_FIRST_NAME=Nexira
DEFAULT_ADMIN_LAST_NAME=Admin
